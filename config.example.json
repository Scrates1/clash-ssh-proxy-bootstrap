{
  "$schema": "./config.schema.json",
  "version": 1,
  "proxy": {
    "localHost": "127.0.0.1",
    "localPort": 7897
  },
  "defaults": {
    "sshPort": 22,
    "identityFile": "~/.ssh/id_ed25519",
    "remoteProxyPort": 17897,
    "noProxyExtra": []
  },
  "targets": [
    {
      "id": "tgt-0123456789abcdef0123456789abcdef",
      "name": "example-linux",
      "host": "linux.example.com",
      "user": "linuxuser",
      "taskName": "ClashProxyTo-example-linux",
      "enabled": true,
      "identityFile": "%LOCALAPPDATA%\\ClashSshProxy\\keys\\tgt-0123456789abcdef0123456789abcdef.ed25519",
      "identityManaged": true
    }
  ]
}
