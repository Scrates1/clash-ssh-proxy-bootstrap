{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Scrates1/clash-ssh-proxy-bootstrap/main/config.schema.json",
  "title": "Clash SSH proxy manager configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "proxy", "defaults", "targets"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localHost", "localPort"],
      "properties": {
        "localHost": { "type": "string", "minLength": 1, "pattern": "^(?!-)[^\\s\\u0000-\\u001F\\u007F]+$" },
        "localPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sshPort", "identityFile", "remoteProxyPort", "noProxyExtra"],
      "properties": {
        "sshPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "identityFile": { "type": "string", "minLength": 1, "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$" },
        "remoteProxyPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "noProxyExtra": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]+$" } }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "host", "user", "taskName"],
        "properties": {
          "id": { "type": "string", "pattern": "^tgt-[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "host": { "type": "string", "minLength": 1, "pattern": "^(?!-)[^\\s@\\u0000-\\u001F\\u007F]+$" },
          "user": { "type": "string", "minLength": 1, "pattern": "^(?!-)[^\\s@\\u0000-\\u001F\\u007F]+$" },
          "taskName": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F\\\\/:*?\"<>|]+$" },
          "enabled": { "type": "boolean", "default": true },
          "sshPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "identityFile": { "type": "string", "minLength": 1, "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$" },
          "identityManaged": { "type": "boolean" },
          "remoteProxyPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "noProxyExtra": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]+$" } }
        }
      }
    }
  }
}
